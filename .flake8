[flake8]
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .venv/*,
    venv/*,
    .pytest_cache,
    .coverage,
    build,
    dist,
    *.egg-info,
    .tox,
    .mypy_cache,
    .DS_Store

max-line-length = 127
max-complexity = 10

ignore = 
    E203,
    W503,
    F401

select = E9,F63,F7,F82
show-source = True
statistics = True
