# Azure ML Configuration
# Copy this file to .env and fill in your Azure ML workspace details

# Azure ML Workspace Configuration
SUBSCRIPTION_ID=your_subscription_id_here
RESOURCE_GROUP=your_resource_group_here
WORKSPACE_NAME=your_workspace_name_here
EXPERIMENT_NAME=used_car_price_prediction

# Optional: Azure ML Compute Configuration
COMPUTE_NAME=cpu-cluster
COMPUTE_SIZE=Standard_DS11_v2

# Optional: Data Configuration
DATA_ASSET_NAME=used-cars-data
MODEL_NAME=used_cars_price_prediction_model
